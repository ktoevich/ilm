# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files to always be LF on checkout.
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
