# Default: normalise line endings.
* text=auto

# Source files always check out with LF.
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Binary assets: never modified, never diffed.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Model weights are ~45 MB. Without LFS every clone downloads them and the
# history keeps a full copy of each revision.
*.pth filter=lfs diff=lfs merge=lfs -text
