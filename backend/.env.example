# Copy to backend/.env and fill in. Never commit the real .env.

# --- Core -----------------------------------------------------------------
# Leave DJANGO_DEBUG unset (or False) anywhere that is not your laptop.
DJANGO_DEBUG=True

# Required whenever DJANGO_DEBUG is False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated. Required when DJANGO_DEBUG is False, except on Railway,
# where RAILWAY_PUBLIC_DOMAIN is picked up automatically (see railway.toml).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Needed when the frontend is served from a different origin than the API.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# Required in production. Omit locally to use backend/db.sqlite3.
DATABASE_URL=

# --- Cache (optional) -----------------------------------------------------
# Without Redis the cache is per-process and is lost on restart, which means
# satellite tiles and SoilGrids lookups are re-fetched more often.
REDIS_URL=

# --- External services ----------------------------------------------------
# Nominatim's usage policy asks for a contact address in the User-Agent.
GEOCODER_CONTACT=you@example.com

# Every data source is free and needs no key or account:
#   Sentinel-2 NDVI ....... Microsoft Planetary Computer (anonymous access)
#   Soil properties ....... ISRIC SoilGrids
#   Weather, elevation .... Open-Meteo
#   Field boundaries ...... OpenStreetMap / Overpass
#   Basemap ............... tile server below
TILE_SERVER_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Set to true to skip Sentinel-2 and always use the RGB basemap index.
# Useful offline or when the Planetary Computer is having a bad day.
DISABLE_SENTINEL=false
MAX_TILES_PER_REQUEST=64
HTTP_TIMEOUT_SECONDS=8

# --- Rate limits ----------------------------------------------------------
THROTTLE_ANALYSIS=30/hour
THROTTLE_CRUD=600/hour

# --- Soil model (optional) ------------------------------------------------
# The ResNet was trained on ground-level soil photos, not satellite tiles.
# Leave this off unless you are deliberately experimenting with it.
ENABLE_SOIL_MODEL_ON_TILES=false
SOIL_MODEL_PATH=

# --- Logging --------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
DJANGO_SQL_LOG_LEVEL=WARNING
